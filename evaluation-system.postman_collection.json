        {
          "name": "GET /measurement-types/:id — 404 inexistente",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/measurement-types/00000000-0000-0000-0000-000000000000", "host": ["{{baseUrl}}"], "path": ["measurement-types", "00000000-0000-0000-0000-000000000000"] }
          },
          "event": [
