{
  "info": {
    "name": "Evaluation System API",
    "description": "Colección completa para el Sistema de Evaluaciones Físicas/Antropométricas.\n\nFlujo recomendado:\n1. MeasurementTypes — verificar catálogo seed\n2. Trainers — crear trainer\n3. Persons — crear persona\n4. Evaluations — crear evaluación completa (transaccional)\n5. BodyComposition, Measurements, DietaryHabits — endpoints separados\n6. Progress — consultar progreso histórico\n7. Health — verificar estado del sistema",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",           "value": "http://localhost:3000", "type": "string" },
    { "key": "measurementTypeId", "value": "",                       "type": "string", "description": "Se llena automáticamente al hacer GET /measurement-types" },
    { "key": "trainerId",         "value": "",                       "type": "string", "description": "Se llena automáticamente al hacer POST /trainers" },
    { "key": "personId",          "value": "",                       "type": "string", "description": "Se llena automáticamente al hacer POST /persons" },
    { "key": "evaluationId",      "value": "",                       "type": "string", "description": "Se llena automáticamente al hacer POST /evaluations" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Database connected', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('ok');",
                  "    pm.expect(json.database).to.eql('connected');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "MeasurementTypes",
      "item": [
        {
          "name": "GET /measurement-types — listar catálogo",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/measurement-types", "host": ["{{baseUrl}}"], "path": ["measurement-types"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna 12 tipos seed', () => pm.expect(pm.response.json().length).to.be.at.least(12));",
                  "// Guarda el ID del tipo WAIST para usarlo en measurements",
                  "const waist = pm.response.json().find(t => t.code === 'WAIST');",
                  "if (waist) {",
                  "    pm.collectionVariables.set('measurementTypeId', waist.id);",
                  "    console.log('WAIST id guardado:', waist.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /measurement-types/:id",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/measurement-types/{{measurementTypeId}}", "host": ["{{baseUrl}}"], "path": ["measurement-types", "{{measurementTypeId}}"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Tiene campos requeridos', () => {",
                  "    const j = pm.response.json();",
                  "    pm.expect(j).to.have.property('id');",
                  "    pm.expect(j).to.have.property('code');",
                  "    pm.expect(j).to.have.property('category');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /measurement-types — crear tipo",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/measurement-types", "host": ["{{baseUrl}}"], "path": ["measurement-types"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"CUSTOM_BICEP\",\n  \"name\": \"Bícep personalizado\",\n  \"unit\": \"cm\",\n  \"category\": \"superior\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('active es true por defecto', () => pm.expect(pm.response.json().active).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /measurement-types — 409 código duplicado",
          "request": {
