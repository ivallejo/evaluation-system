    {
      "name": "Evaluations",
      "item": [
        {
          "name": "POST /persons/:personId/evaluations — completa (transaccional)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/persons/{{personId}}/evaluations", "host": ["{{baseUrl}}"], "path": ["persons", "{{personId}}", "evaluations"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trainerId\": \"{{trainerId}}\",\n  \"evaluationDate\": \"2024-09-04\",\n  \"objective\": \"Reducción de grasa corporal\",\n  \"trainingLevel\": \"intermediate\",\n  \"bodyComposition\": {\n    \"weightKg\": 72.5,\n    \"heightM\": 1.65,\n    \"bmi\": 26.6,\n    \"bodyFatPercentage\": 28.0,\n    \"muscleMassPercentage\": 34.0,\n    \"boneMassKg\": 2.8\n  },\n  \"measurements\": [\n    { \"measurementTypeId\": \"{{measurementTypeId}}\", \"value\": 32.5 }\n  ],\n  \"dietaryHabits\": {\n    \"description\": \"Dieta alta en proteína, baja en carbohidratos. Come 4 veces al día.\"\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Retorna evaluación con sub-objetos', () => {",
                  "    pm.expect(j).to.have.property('bodyComposition');",
                  "    pm.expect(j).to.have.property('measurements');",
                  "    pm.expect(j).to.have.property('dietaryHabits');",
                  "});",
                  "pm.test('measurements tiene 1 item', () => pm.expect(j.measurements.length).to.eql(1));",
                  "const evalId = j.evaluation ? j.evaluation.id : j.id;",
                  "pm.collectionVariables.set('evaluationId', evalId);",
                  "console.log('evaluationId guardado:', evalId);"
                ]
              }
            }
          ]
        },
