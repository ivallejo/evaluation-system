                  "pm.test('Es array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Orden ascendente por fecha', () => {",
                  "    const records = pm.response.json();",
                  "    for (let i = 1; i < records.length; i++) {",
                  "        pm.expect(new Date(records[i].evaluationDate) >= new Date(records[i-1].evaluationDate)).to.be.true;",
                  "    }",
                  "});",
                  "pm.test('Estructura correcta', () => {",
                  "    const records = pm.response.json();",
                  "    if (records.length > 0) {",
                  "        pm.expect(records[0]).to.have.property('evaluationDate');",
                  "        pm.expect(records[0]).to.have.property('weightKg');",
                  "        pm.expect(records[0]).to.have.property('bodyFatPercentage');",
                  "        pm.expect(records[0]).to.have.property('muscleMassPercentage');",
